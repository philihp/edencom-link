CRON_SECRET=random-secret-shared-with-vercel-cron
# Salts share-link signatures (src/shareToken.ts): a URL token is an HMAC keyed
# by the share row's secret AND this value, so a database dump alone can't mint
# valid links. Any long random string; rotating it invalidates every share link.
TOKEN_SALT=
# ISK price appraisals via https://innomin.at/api/docs/ (key issued via their Discord)
INNOMINATE_API_KEY=

# Discord application (developer portal → your app). APP_ID and PUBLIC_KEY are
# public identifiers; BOT_TOKEN is secret. PUBLIC_KEY verifies the signature on
# inbound interactions (/api/discord/interactions); BOT_TOKEN authenticates
# outbound REST calls (used from a later stage).
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# GICE (Goonfleet SSO) OpenID Connect application — register one while signed
# in at https://gice.goonfleet.com/ (POST /Api/Oauth/Application with your
# temporary token; the clientSecret is shown only once). The callback URL must
# be listed in the application's redirectUris.
GICE_CLIENT_ID=
GICE_SECRET_KEY=
GICE_CALLBACK_URL=http://localhost:3000/account/gice/callback

# The site's public origin, used only where an absolute URL has to be built
# server-side with no request to read a Host from — today the MCP create_lens
# tool, which returns share links (src/utils/siteUrl.ts). On Vercel this can be
# left unset: VERCEL_PROJECT_PRODUCTION_URL covers it. Unset locally, the tools
# return paths instead of URLs.
NEXT_PUBLIC_SITE_URL=

# this is so NextJS will make these things available in client components
NEXT_PUBLIC_SUPABASE_URL=https://ifqywgxsdjxbonsytqya.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...JIM